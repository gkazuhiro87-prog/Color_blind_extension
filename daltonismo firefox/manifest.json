{
  "manifest_version": 3,
  "name": "Acessibilidade Visual - Daltonismo",
  "version": "1.2",
  "description": "Aplica correções e simulações de cores em tempo real.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sua-extensao-daltonismo@seu-dominio.com",
      "strict_min_version": "109.0"
    }
  }
}
