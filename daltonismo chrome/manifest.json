{
  "manifest_version": 3,
  "name": "Acessibilidade Visual - Daltonismo",
  "version": "1.2",
  "description": "Aplica correções e simulações de cores em tempo real com salvamento automático.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
